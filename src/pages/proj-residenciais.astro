<Layout title="Projetos Residenciais | Arquitetura & Interiores">
  <div class="page">
    <Header active="/proj-residenciais" />
    <ProjectGrid pasta="residenciais" projetos={projetos} />
    <Social />
  </div>
</Layout>

<style>
  .page {
    max-width: 1272px;
    margin: 0 auto;
    padding-top: 90px;
    padding-bottom: 80px;
  }

  @media (max-width: 1000px) {
    .page {
      padding: 30px 16px 60px;
    }
  }
</style>
