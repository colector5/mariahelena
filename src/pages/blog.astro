---

<Layout title="Blog | Arquitetura & Interiores">
  <div class="page">
    <Header active="/blog" />

    <section class="blog-header">
      <h1>Blog</h1>
      <p class="subtitle">Artigos sobre arquitetura, design de interiores e tendências</p>
    </section>

    <section class="posts-grid">
      {posts.map((post) => (
        <a href={post.url} class="card">
          <div class="card-img">
            {post.imagem ? (
              <img src={post.imagem} alt={post.titulo} />
            ) : (
              <div class="placeholder-img">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="3" y="3" width="18" height="18" rx="2" />
                  <circle cx="8.5" cy="8.5" r="1.5" />
                  <path d="m21 15-5-5L5 21" />
                </svg>
              </div>
            )}
          </div>
          <div class="card-body">
            <span class="categoria">{post.categoria}</span>
            <h2>{post.titulo}</h2>
            <p class="resumo">{post.resumo}</p>
            <span class="data">{post.data}</span>
          </div>
        </a>
      ))}
    </section>

    <Social />
  </div>
</Layout>

<style>
  .page {
    max-width: 1272px;
    margin: 0 auto;
    padding-top: 90px;
    padding-bottom: 80px;
  }

  .blog-header {
    margin: 24px 0 32px;
  }

  .blog-header h1 {
    margin: 0;
    font-size: 32px;
    font-weight: 400;
    color: #4f4a45;
    letter-spacing: 2px;
  }

  .subtitle {
    margin: 6px 0 0;
    font-size: 15px;
    color: #8a847d;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-bottom: 50px;
  }

  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid #e8e4de;
    transition: box-shadow 0.3s, transform 0.3s;
    overflow: hidden;
  }

  .card:hover {
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.08);
    transform: translateY(-3px);
  }

  .card-img {
    aspect-ratio: 16 / 9;
    background: #f3f0eb;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .card:hover .card-img img {
    transform: scale(1.04);
  }

  .placeholder-img {
    width: 48px;
    height: 48px;
    color: #c5bfb7;
  }

  .placeholder-img svg {
    width: 100%;
    height: 100%;
  }

  .card-body {
    padding: 20px 22px 24px;
  }

  .categoria {
    display: inline-block;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #9a8f82;
    background: #f3f0eb;
    padding: 3px 10px;
    margin-bottom: 10px;
  }

  .card h2 {
    margin: 0 0 8px;
    font-size: 18px;
    font-weight: 400;
    color: #4f4a45;
    line-height: 1.35;
  }

  .card:hover h2 {
    color: #9a8f82;
  }

  .resumo {
    margin: 0 0 14px;
    font-size: 14px;
    line-height: 1.55;
    color: #7a756f;
  }

  .data {
    font-size: 12px;
    color: #b0a99f;
  }

  @media (max-width: 1000px) {
    .page {
      padding: 30px 16px 60px;
    }
    .posts-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 600px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

