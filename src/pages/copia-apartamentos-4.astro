---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Social from '../components/Social.astro';

const fotos = [
  { url: '/images/apartamentos/apartment_interior_1_1790628979911.jpg', alt: 'Apartamento Interior 1' },
  { url: '/images/apartamentos/apartment_interior_2_1790628991733.jpg', alt: 'Apartamento Interior 2' },
  { url: '/images/apartamentos/apartment_interior_3_1790629012279.jpg', alt: 'Apartamento Interior 3' },
  { url: '/images/apartamentos/apartment_interior_4_1790629024613.jpg', alt: 'Apartamento Interior 4' },
  { url: '/images/apartamentos/apartment_interior_5_1790629036998.jpg', alt: 'Apartamento Interior 5' },
  { url: '/images/apartamentos/apartment_interior_6_1790629048007.jpg', alt: 'Apartamento Interior 6' },
  { url: '/images/apartamentos/apartment_interior_1_1790628979911.jpg', alt: 'Apartamento Interior 1' },
  { url: '/images/apartamentos/apartment_interior_2_1790628991733.jpg', alt: 'Apartamento Interior 2' },
  { url: '/images/apartamentos/apartment_interior_3_1790629012279.jpg', alt: 'Apartamento Interior 3' },
  { url: '/images/apartamentos/apartment_interior_4_1790629024613.jpg', alt: 'Apartamento Interior 4' },
  { url: '/images/apartamentos/apartment_interior_5_1790629036998.jpg', alt: 'Apartamento Interior 5' },
  { url: '/images/apartamentos/apartment_interior_6_1790629048007.jpg', alt: 'Apartamento Interior 6' }
];
---

<Layout title="Apartamento | Arquitetura & Interiores">
  <div class="page">
    <Header active="/proj-residenciais" />

    <div class="gallery-header">
      <p class="intro">Clique na fotografia para v&ecirc;-la ampliada</p>
      <h1 class="gallery-title">APARTAMENTO 4</h1>
    </div>

    <section class="gallery-grid">
      {fotos.map((foto) => (
        <a href={foto.url.replace('&w=800', '&w=1600')} target="_blank" class="gallery-item">
          <div class="foto-wrapper">
            <img 
              src={foto.url} 
              alt={foto.alt} 
              loading="lazy" 
            />
          </div>
        </a>
      ))}
    </section>

    <Social />
  </div>
</Layout>

<style>
  .page {
    max-width: 1272px;
    margin: 0 auto;
    padding-top: 90px;
    padding-bottom: 80px;
  }

  .gallery-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin: 20px 0 24px;
  }

  .intro {
    font-size: 14px;
    color: #8c8c8c;
    margin: 0;
  }

  .gallery-title {
    font-size: 16px;
    font-weight: 400;
    color: #5a5550;
    margin: 0;
    letter-spacing: 0.5px;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px 22px;
    margin-bottom: 50px;
  }

  .gallery-item {
    display: block;
  }

  .foto-wrapper {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #c8c8c8;
  }

  .foto-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .gallery-item:hover .foto-wrapper img {
    transform: scale(1.04);
  }

  @media (max-width: 1000px) {
    .page {
      padding: 30px 16px 60px;
    }
    
    .gallery-header {
      flex-direction: column;
      gap: 12px;
    }

    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px 12px;
    }
  }

  @media (max-width: 600px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
